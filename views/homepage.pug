doctype html
html
    head
        title= title
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")
    body
        h1 Video Games Table
        a.add-link(href="/update-cobj") Add to this table
        table.cobj-table
            thead
                tr
                    th Name
                    th Console
                    th Genre
            tbody
                each game in data
                    tr
                        td #{game.properties.name}
                        td #{game.properties.console}
                        td #{game.properties.genre}
