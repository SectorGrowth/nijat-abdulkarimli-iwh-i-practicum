doctype html
html
    head
        title= title
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")
    body
        h1= title
        h3 Add a new video game to the CRM
        form(action="/update-cobj" method="POST")
            label(for="name") Name:
            input(type="text" id="name" name="name" required)

            label(for="console") Console:
            select(id="console" name="console" required)
                option(value="" disabled selected) -- Select a console --
                if consoleOptions && consoleOptions.length
                    each consoleOption in consoleOptions
                        option(value=consoleOption.value) #{consoleOption.label}

            label(for="genre") Genre:
            input(type="text" id="genre" name="genre" required)

            button(type="submit") Submit
        a(href="/") Return to the homepage
